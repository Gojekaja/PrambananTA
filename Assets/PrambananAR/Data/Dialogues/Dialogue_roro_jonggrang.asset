  m_Script: {fileID: 11500000, guid: 20691492f4b17234db60c73bf6216490, type: 3}
  m_Name: Dialogue_roro_jonggrang
  m_EditorClassIdentifier: Assembly-CSharp::PrambananAR.UI.DialogueData
  lines:
  - speaker: Roro Jonggrang
    portrait: {fileID: 21300000, guid: c41ebc674b0e0694c9fbb9d2886f999c, type: 3}
    text: Halo, Penjelajah Cilik! Aku Roro Jonggrang, putri Kerajaan Prambanan.
  - speaker: Roro Jonggrang
    portrait: {fileID: 21300000, guid: c41ebc674b0e0694c9fbb9d2886f999c, type: 3}
    text: 'Dahulu, Bandung Bondowoso ingin menikah denganku. Aku memberinya syarat:
      membangun seribu candi dalam satu malam!'
  - speaker: Roro Jonggrang
    portrait: {fileID: 21300000, guid: c41ebc674b0e0694c9fbb9d2886f999c, type: 3}
    text: Mau tahu kelanjutan ceritaku? Buka halaman Cerita, ya!
