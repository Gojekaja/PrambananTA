  m_Script: {fileID: 11500000, guid: 20691492f4b17234db60c73bf6216490, type: 3}
  m_Name: Dialogue_gadis_desa
  m_EditorClassIdentifier: Assembly-CSharp::PrambananAR.UI.DialogueData
  lines:
  - speaker: Gadis Penumbuk Padi
    portrait: {fileID: 21300000, guid: 6b14081d2fd1a80479ebdd766f7171c6, type: 3}
    text: Tok... tok... tok! Kami menumbuk padi di tengah malam.
  - speaker: Gadis Penumbuk Padi
    portrait: {fileID: 21300000, guid: 6b14081d2fd1a80479ebdd766f7171c6, type: 3}
    text: Suaranya membuat ayam jantan mengira hari sudah pagi!
